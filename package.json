{
  "name": "versie",
  "version": "1.1.6",
  "description": "A simple and adaptive version management library",
  "author": "Lyr",
  "license": "Apache-2.0",
  "keywords": [
    "version",
    "browser",
    "vcs"
  ],
  "repository": {
    "url": "git+https://github.com/lyr-7d1h/versie"
  },
  "main": "dist/versie.cjs",
  "module": "dist/versie.mjs",
  "types": "dist/versie.d.ts",
  "exports": {
    ".": {
      "types": "./dist/versie.d.ts",
      "import": "./dist/versie.mjs",
      "require": "./dist/versie.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "lint": "eslint src --max-warnings 0",
    "lint:fix": "eslint src --fix",
    "test": "vitest",
    "build": "vite build",
    "build:watch": "vite build --watch"
  },
  "dependencies": {
    "fast-diff": "^1.3.0",
    "lru-cache": "11.3.5",
    "typescript-result": "^3.5.2",
    "zod": "4.4.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "25.6.0",
    "eslint": "10.3.0",
    "fake-indexeddb": "^6.2.5",
    "typescript-eslint": "8.59.1",
    "vite": "8.0.10",
    "vite-plugin-dts": "5.0.0",
    "vitest": "4.1.5"
  }
}
